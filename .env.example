# Extra allowed origins for POST /api/contact, comma separated (optional).
# The production site (https://www.pranksims.com and the bare pranksims.com),
# localhost in dev, and the current Vercel deployment URL are always allowed.
# Example: https://staging.pranksims.com
ALLOWED_ORIGIN=

# EmailJS credentials - all three are required for server-side sending.
# Find these in your EmailJS dashboard at https://dashboard.emailjs.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PRIVATE_KEY=

# Global rate limiting for the contact form (recommended in production).
# Create a free Redis database at https://upstash.com and copy the REST URL and
# token. Without these the limiter falls back to per-instance memory, which
# serverless cold starts and parallel instances can sidestep.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
