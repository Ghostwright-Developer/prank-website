# The public-facing origin of your site (no trailing slash).
# Used to validate Origin/Referer headers on form submissions.
# Example: https://pranksims.com
ALLOWED_ORIGIN=

# EmailJS credentials — all three are required for server-side sending.
# Find these in your EmailJS dashboard at https://dashboard.emailjs.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PRIVATE_KEY=
